{
  "name": "globber",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=@globber/web",
    "dev:web": "turbo run dev --filter=@globber/web",
    "dev:https": "pnpm --filter @globber/web dev:https",
    "dev:tunnel": "pnpm --filter @globber/web dev:tunnel",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@globber/web",
    "start": "pnpm --filter @globber/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "fix": "turbo run lint:fix && prettier --write .",
    "check": "turbo run lint:check && prettier --check .",
    "tokens:build": "pnpm --filter @globber/tokens build",
    "prepare": "husky",
    "dev:mobile": "pnpm --filter @globber/mobile start",
    "ios": "pnpm --filter @globber/mobile ios",
    "android": "pnpm --filter @globber/mobile android",
    "test": "turbo run test && pnpm test:harness",
    "test:harness": "vitest run && node --test .harness/*.test.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.7.4",
    "turbo": "^2.5.0",
    "vitest": "^3"
  },
  "packageManager": "pnpm@9.1.0",
  "pnpm": {
    "overrides": {
      "axios": "^1.20.0",
      "baseline-browser-mapping": "latest",
      "@types/react": "~19.2.4"
    }
  }
}
